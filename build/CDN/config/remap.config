# 鉴权内部请求：/newaoe/kn.png → /downloadauth/kn.png
# 必须放在通用 map / 之前
map http://114.66.62.156:8080/ \
    http://114.66.62.156:8080/api/downloadauth/ \
    @action=allow @internal

# 客户端正常请求
map / http://114.66.62.156:9000/newaoe/ \
  @plugin=authproxy.so \
  @pparam=--auth-transform=redirect \
  @pparam=--auth-host=114.66.62.156 \
  @pparam=--auth-port=8080 \
  @plugin=header_rewrite.so \
  @pparam=/opt/etc/trafficserver/download_headers.config \
  @plugin=origin_server_auth.so \
  @pparam=--config \
  @pparam=/opt/etc/trafficserver/s3_auth_v4.config